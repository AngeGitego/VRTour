  m_Name: 
  m_EditorClassIdentifier: 
  rooms:
  - {fileID: 390596529}
  - {fileID: 1453003429}
  - {fileID: 1359497334}
  - {fileID: 618385656}
  - {fileID: 448945579}
  - {fileID: 1166288460}
  roomText: {fileID: 1449918171}
  nextButton: {fileID: 1247452645}
  previousButton: {fileID: 434096253}
  roomDescriptions:
  - "Welcome to our office reception. This is where first impressions are made\u2014bright,
    welcoming, and designed to offer comfort while you wait. Notice the modern d\xE9cor
    and friendly atmosphere that sets the tone for the rest of the workspace"
  - "\"This is the main hall, the heart of our office. It\u2019s a spacious area
    where employees gather, collaborate, or relax between meetings. Natural light
    and open design create an environment that encourages creativity and interaction."
  - Welcome to the boardroom, our central space for strategy, discussions, and decision-making.
    Equipped with modern technology and a professional layout, it supports productive
    meetings and creative brainstorming sessions.
  - "The corridor connects different parts of the office, designed with art and functional
    d\xE9cor to make every walk inspiring. Along the walls, you\u2019ll notice framed
    achievements and visuals that reflect our company culture."
  - "This is the kitchen, a space where employees recharge. It\u2019s equipped for
    coffee breaks, meals, and informal conversations, fostering a sense of community
    while maintaining a clean and efficient design."
  - "Our balcony offers a breath of fresh air and a view of the surroundings. It\u2019s
    the perfect spot for short breaks, informal chats, or moments of reflection outside
    the office environment."
  outroSceneName: Outroscene
  fadeController: {fileID: 956678529}
